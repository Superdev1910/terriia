# Copiar como .env y completar. El .env NUNCA se sube a GitHub.
# Aquí solo van valores de ejemplo (placeholders): jamás pegues claves reales en este archivo.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Clave secreta: larga y aleatoria, distinta en cada entorno. OBLIGATORIA salvo con DJANGO_DEBUG=True
# (sin clave y sin debug, Django no arranca).
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Por defecto es False (seguro). En tu computador descomenta la línea siguiente (SOLO desarrollo;
# nunca en el servidor):
# DJANGO_DEBUG=True
# Dominios o IP desde los que se atiende el sitio, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes https permitidos para formularios (ej. https://terriia.ejemplo.cl). Vacío en local.
DJANGO_CSRF_TRUSTED_ORIGINS=

# HTTPS: hoy el servidor atiende por HTTP y falta el certificado. Cuando nginx ya sirva el sitio
# por https, poner DJANGO_HTTPS=True: activa cookies de sesión y CSRF "Secure", redirección a https
# y HSTS. Con True y sin certificado el sitio deja de funcionar (bucle de redirección).
DJANGO_HTTPS=False
# Segundos de HSTS (por defecto 1 año). Bájalo (ej. 300) para la primera prueba.
# DJANGO_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Local: dejar DB_ENGINE=sqlite (usa db.sqlite3). Servidor: DB_ENGINE=mysql (MariaDB/MySQL).
DB_ENGINE=sqlite
DB_NAME=terriia
DB_USER=terriia
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------------------------------------------------------------------------
# Correo (recuperar contraseña)
# ---------------------------------------------------------------------------
# Local: dejar la consola (el código sale en la terminal del servidor).
# Para recibir el correo real en local, sigue docs/LEEME-correo.md (la clave se pide a Patricio por privado).
# Servidor: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend y completar los datos SMTP.
# Si EMAIL_BACKEND falta en el servidor, los códigos solo se imprimen en el log (ver docs/incidencias-configuracion.md).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TerriIA <no-responder@laserena.cl>
# Minutos de vigencia del código de recuperación.
RECUPERACION_MINUTOS=15

# ---------------------------------------------------------------------------
# Actividades
# ---------------------------------------------------------------------------
# Días de gracia tras el domingo para registrar en la semana anterior (a confirmar con el cliente).
SEMANA_CIERRE_DIAS_GRACIA=1

# ---------------------------------------------------------------------------
# Evidencias (archivos subidos a una actividad)
# ---------------------------------------------------------------------------
# Los archivos NO tienen URL pública: se bajan por /api/evidencias/<id>/archivo/ con control de
# delegación. Local: dejar vacío (Django entrega el archivo).
# Producción con nginx (deploy/nginx-terriia.conf): EVIDENCIAS_X_ACCEL_PREFIX=/media
# (debe coincidir con el `location /media/ { internal; ... }` de nginx).
EVIDENCIAS_X_ACCEL_PREFIX=
# Máximo de evidencias por actividad.
EVIDENCIAS_MAX_POR_ACTIVIDAD=10

# ---------------------------------------------------------------------------
# Demostración
# ---------------------------------------------------------------------------
# DEMO_CLAVE: clave de los usuarios de demostración. La lee `python manage.py cargar_demo`.
# Mínimo 8 caracteres y debe cumplir las reglas de contraseña. Solo para demo o evaluación:
# no la uses en producción real ni la reutilices. Déjala vacía si no cargas datos demo.
DEMO_CLAVE=
