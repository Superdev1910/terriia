# Copiar como .env y completar. El .env NUNCA se sube a GitHub.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local: dejar DB_ENGINE=sqlite. Servidor: DB_ENGINE=mysql
DB_ENGINE=sqlite
DB_NAME=terriia
DB_USER=terriia
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
