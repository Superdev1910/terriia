# Copiar como .env y completar. El .env NUNCA se sube a GitHub.
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local: dejar DB_ENGINE=sqlite. Servidor: DB_ENGINE=mysql
DB_ENGINE=sqlite
DB_NAME=terriia
DB_USER=terriia
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Correo para "Recuperar contraseña". Local: dejar así (el código sale en la consola del servidor).
# Para recibir el correo real en local, sigue docs/LEEME-correo.md (la clave se pide a Patricio por privado).
# Servidor: cambiar a django.core.mail.backends.smtp.EmailBackend y completar los datos SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=TerriIA <no-responder@laserena.cl>
RECUPERACION_MINUTOS=15
